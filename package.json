{
  "name": "@dafcoe/iberian-fuel-client",
  "version": "1.0.0",
  "description": "A typescript client to fetch fuel data of Portuguese and Spanish fuel stations",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/dev.ts",
    "audit-brands": "tsx scripts/brand-auditor.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm run lint && pnpm run test && tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "keywords": [
    "dgeg",
    "minetur",
    "fuel",
    "portugal",
    "spain",
    "iberia",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "jiti": "^2.7.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@dafcoe/dgeg-client": "^1.0.0",
    "@dafcoe/minetur-client": "^1.0.0"
  }
}